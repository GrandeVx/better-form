FROM node:24.22.0-bookworm-slim AS base
ARG TARGETARCH
RUN set -eu; \
    case "$TARGETARCH" in \
      amd64) node_arch=x64; node_sha=6c172a9ab6718f7b801fb5a7bd486af2ee5e32758086a04b84fcce2aa77095e6 ;; \
      arm64) node_arch=arm64; node_sha=dbabf7a1cbf947e6059ffad2c27b80041db97dea1e553b62afdee7f13fca336e ;; \
      *) echo "Unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl xz-utils; \
    curl -fsSLo /tmp/node.tar.xz "https://nodejs.org/dist/v24.22.1/node-v24.22.1-linux-${node_arch}.tar.xz"; \
    echo "$node_sha  /tmp/node.tar.xz" | sha256sum -c -; \
    tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1; \
    rm /tmp/node.tar.xz; \
    rm -rf /var/lib/apt/lists/*; \
    test "$(node --version)" = "v24.22.1"

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

FROM base AS deps
WORKDIR /app

# Copy workspace config and lockfile
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./

# Copy docs package.json for workspace resolution
COPY docs/package.json ./docs/

RUN pnpm install --frozen-lockfile

FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/docs/node_modules ./docs/node_modules

# Copy docs source
COPY docs ./docs
COPY pnpm-workspace.yaml package.json ./

# Build docs
RUN pnpm --filter @better_form/docs build

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copy root node_modules (contains .pnpm store that docs/node_modules symlinks to)
COPY --from=builder --chown=nextjs:nodejs /app/node_modules ./node_modules
# Copy standalone output to docs folder (preserving monorepo structure for symlinks)
COPY --from=builder --chown=nextjs:nodejs /app/docs/.next/standalone ./docs/
# Copy docs node_modules (symlinks to ../node_modules/.pnpm)
COPY --from=builder --chown=nextjs:nodejs /app/docs/node_modules ./docs/node_modules
# Copy static files
COPY --from=builder --chown=nextjs:nodejs /app/docs/.next/static ./docs/.next/static
# Copy public folder
COPY --from=builder /app/docs/public ./docs/public

USER nextjs
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "docs/server.js"]
